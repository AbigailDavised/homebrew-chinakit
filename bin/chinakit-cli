  }
];

const args = process.argv.slice(2);

if (args.includes('--version') || args.includes('-v')) {
  console.log('chinakit-cli v1.0.0 (https://chinakit.io)');
  process.exit(0);
}

if (args.includes('--routes')) {
  console.log(JSON.stringify({ domain: 'chinakit.io', endpoints: ROUTES }, null, 2));
  process.exit(0);
}

if (args.includes('--specs') || args.includes('--json')) {
  console.log(JSON.stringify({ domain: 'chinakit.io', benchmark: "Inbound China Statutory & Payment Threshold Matrix (2026)", rows: SPECS }, null, 2));
  process.exit(0);
}

console.log([
  'ChinaKit CLI (chinakit-cli v1.0.0)',
  'Inbound China CAAC Wh Power-Bank, TWOV & Statutory Compliance Reference CLI',
  'Homepage: https://chinakit.io',
  '',
  'Usage:',
  '  chinakit-cli --help       Show command overview and verified endpoints',
  '  chinakit-cli --version    Print CLI version',
  '  chinakit-cli --specs      Output domain technical specification matrix as JSON',
  '  chinakit-cli --routes     Output verified production URLs as JSON',
  '',
  'Verified Production Endpoints:',
  ...ROUTES.map((r) => '  - ' + r.name + ': ' + r.url),
].join('\n'));
